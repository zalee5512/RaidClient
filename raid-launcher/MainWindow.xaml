<Window x:Class="RaidLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Raid Launcher - 1.8.9 PvP" Height="620" Width="980"
        Icon="Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E95A5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2030"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2638"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00E5FF"/>
            <Setter Property="Foreground" Value="#0C1017"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33ECFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#00B4D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RaidProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#10141F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0084FF" Offset="0.0"/>
                                            <GradientStop Color="#00E5FF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0E1118" CornerRadius="12" BorderBrush="#232A3B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#141824" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/icon.png" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="RAID LAUNCHER" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0 • Minecraft 1.8.9" Margin="10,0,0,0" FontSize="11" Foreground="#656E84" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Width="32" Height="28" Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click"/>
                        <Button Content="✕" Width="32" Height="28" Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Layout -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#121622" BorderBrush="#1C2232" BorderThickness="0,0,1,0">
                    <Grid Margin="15,20">
                        <StackPanel>
                            <TextBlock Text="NAVEGACIÓN" FontSize="11" FontWeight="Bold" Foreground="#4E566D" Margin="5,0,0,10"/>
                            <RadioButton Content="🚀  Jugar" IsChecked="True" Style="{StaticResource NavButtonStyle}" Checked="NavPlay_Checked"/>
                            <RadioButton Content="👤  Cuentas" Style="{StaticResource NavButtonStyle}" Checked="NavAccounts_Checked"/>
                            <RadioButton Content="⚙️  Ajustes" Style="{StaticResource NavButtonStyle}" Checked="NavSettings_Checked"/>
                            <RadioButton Content="🔍  Hardware &amp; FPS" Style="{StaticResource NavButtonStyle}" Checked="NavHardware_Checked"/>
                        </StackPanel>

                        <!-- Client Status Badge at bottom of sidebar -->
                        <Border VerticalAlignment="Bottom" Background="#181D2B" CornerRadius="8" Padding="12" BorderBrush="#252C3D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CLIENTE INSTALADO" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                <TextBlock Text="Raid Client 1.8.9" FontWeight="SemiBold" FontSize="12" Foreground="#FFF" Margin="0,2,0,0"/>
                                <TextBlock Text="Shift Derecho para abrir HUD" FontSize="10" Foreground="#8E95A5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Column="1" Margin="25">
                    
                    <!-- TAB 1: JUGAR -->
                    <Grid x:Name="TabPlay" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="100"/>
                        </Grid.RowDefinitions>

                        <!-- Hero Banner -->
                        <Border Grid.Row="0" Background="#141826" CornerRadius="12" Padding="25" BorderBrush="#232A3E" BorderThickness="1">
                            <Grid>
                                <StackPanel VerticalAlignment="Top">
                                    <Border HorizontalAlignment="Left" Background="#1E2A3A" CornerRadius="4" Padding="8,3" Margin="0,0,0,10">
                                        <TextBlock Text="PVP &amp; PERFORMANCE CLIENT" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Border>
                                    <TextBlock Text="RAID CLIENT" FontSize="36" FontWeight="Black" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Optimizado para Minecraft 1.8.9 • Menú HUD con Shift Derecho" FontSize="14" Foreground="#8E95A5" Margin="0,4,0,20"/>

                                    <!-- Feature Highlights -->
                                    <UniformGrid Columns="2" Margin="0,10,0,0">
                                        <Border Background="#181D2C" CornerRadius="8" Padding="12" Margin="0,0,8,8" BorderBrush="#22283A" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="🎯 Custom Crosshair" FontWeight="Bold" FontSize="13" Foreground="#00E5FF"/>
                                                <TextBlock Text="Mira personalizada con color RGBA, tamaño y grosor ajustable." FontSize="11" Foreground="#7E879B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#181D2C" CornerRadius="8" Padding="12" Margin="8,0,0,8" BorderBrush="#22283A" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="📦 Hitbox Viewer" FontWeight="Bold" FontSize="13" Foreground="#00E5FF"/>
                                                <TextBlock Text="Cajas de colisión en tiempo real con línea de mirada para PvP." FontSize="11" Foreground="#7E879B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#181D2C" CornerRadius="8" Padding="12" Margin="0,8,8,0" BorderBrush="#22283A" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="⌨️ Keystrokes &amp; CPS" FontWeight="Bold" FontSize="13" Foreground="#00E5FF"/>
                                                <TextBlock Text="Contador de clicks y teclas WASD con animaciones reactivas." FontSize="11" Foreground="#7E879B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#181D2C" CornerRadius="8" Padding="12" Margin="8,8,0,0" BorderBrush="#22283A" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="⚡ ToggleSprint &amp; FPS" FontWeight="Bold" FontSize="13" Foreground="#00E5FF"/>
                                                <TextBlock Text="Correr automático y motor de renderizado ultra optimizado." FontSize="11" Foreground="#7E879B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bottom Launch Bar -->
                        <Border Grid.Row="1" Background="#141826" CornerRadius="12" Margin="0,15,0,0" Padding="15" BorderBrush="#232A3E" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <!-- Active Account Info -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="45" Height="45" Background="#1D2333" CornerRadius="8" Margin="0,0,15,0">
                                        <Image x:Name="ImgActiveAvatar" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtActiveUsername" Text="RaidPlayer" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                                            <Border x:Name="BadgeAccountType" Background="#283247" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="TxtAccountType" Text="NO-PREMIUM" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtActiveSettingsSummary" Text="Versión: 1.8.9 • RAM: 3 GB" FontSize="12" Foreground="#8E95A5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Big Launch Button & Loading Bar Area -->
                                <Grid Grid.Column="1">
                                    <!-- Normal Play Button -->
                                    <Button x:Name="BtnPlay" Content="JUGAR (1.8.9)" Height="52" Style="{StaticResource ActionButtonStyle}" FontSize="16" Click="BtnPlay_Click"/>

                                    <!-- Loading Progress Panel -->
                                    <Border x:Name="PanelLaunchProgress" Background="#161C2C" CornerRadius="8" Height="52" BorderBrush="#00E5FF" BorderThickness="1.5" Visibility="Collapsed" Padding="12,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <TextBlock x:Name="TxtProgressStep" Text="Iniciando..." FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                                <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <ProgressBar Grid.Row="1" x:Name="ProgressBarLaunch" Style="{StaticResource RaidProgressBarStyle}" Height="8" Minimum="0" Maximum="100" Value="0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 2: CUENTAS -->
                    <Grid x:Name="TabAccounts" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Gestor de Cuentas" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15"/>

                        <!-- Accounts List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PanelAccountsList"/>
                        </ScrollViewer>

                        <!-- Add Account Cards -->
                        <Grid Grid.Row="2" Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Add No-Premium Card -->
                            <Border Grid.Column="0" Background="#141826" CornerRadius="10" Padding="15" Margin="0,0,10,0" BorderBrush="#232A3E" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="AGREGAR NO-PREMIUM" FontSize="12" FontWeight="Bold" Foreground="#00E5FF"/>
                                    <TextBlock Text="Ingresa cualquier nombre de usuario para jugar offline." FontSize="11" Foreground="#7E879B" Margin="0,2,0,10"/>
                                    <TextBox x:Name="TxtOfflineUsername" Height="36" Background="#0F121C" Foreground="#FFF" BorderBrush="#252C3E" Padding="10,8" FontSize="13" Margin="0,0,0,10"/>
                                    <Button Content="+ Agregar No-Premium" Style="{StaticResource ActionButtonStyle}" Background="#1E273A" Foreground="#00E5FF" Click="BtnAddOffline_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Add Premium Card -->
                            <Border Grid.Column="1" Background="#141826" CornerRadius="10" Padding="15" Margin="10,0,0,0" BorderBrush="#232A3E" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="INICIAR SESIÓN PREMIUM" FontSize="12" FontWeight="Bold" Foreground="#00E5FF"/>
                                    <TextBlock Text="Conecta tu cuenta oficial de Microsoft / Xbox Live." FontSize="11" Foreground="#7E879B" Margin="0,2,0,10"/>
                                    <TextBlock x:Name="TxtMicrosoftStatus" Text="Listo para conectar." FontSize="11" Foreground="#8E95A5" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    <Button x:Name="BtnMicrosoftLogin" Content="🔑 Iniciar con Microsoft" Style="{StaticResource ActionButtonStyle}" Click="BtnMicrosoftLogin_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TAB 3: AJUSTES -->
                    <Grid x:Name="TabSettings" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Ajustes del Launcher y Juego" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

                            <Border Background="#141826" CornerRadius="10" Padding="20" BorderBrush="#232A3E" BorderThickness="1">
                                <StackPanel>
                                    <!-- RAM Slider -->
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="Memoria RAM Asignada" FontSize="14" FontWeight="SemiBold" Foreground="#FFF"/>
                                        <TextBlock x:Name="TxtRamValue" Text="3 GB" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SliderRam" Minimum="1" Maximum="16" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,25" ValueChanged="SliderRam_ValueChanged"/>

                                    <!-- Java Path -->
                                    <TextBlock Text="Ruta de Java (JDK 8 / OpenJDK)" FontSize="14" FontWeight="SemiBold" Foreground="#FFF" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtJavaPath" Height="36" Background="#0F121C" Foreground="#FFF" BorderBrush="#252C3E" Padding="10,8" FontSize="12"/>
                                        <Button Grid.Column="1" Content="Detectar" Style="{StaticResource ActionButtonStyle}" Background="#1E273A" Foreground="#00E5FF" Margin="10,0,0,0" Click="BtnDetectJava_Click"/>
                                    </Grid>

                                    <!-- PvP JVM Optimization Checkbox -->
                                    <CheckBox x:Name="ChkOptimizePvp" Content="Activar optimización de Garbage Collector para PvP (Menor latencia de frames)" Foreground="#FFF" FontSize="13" IsChecked="True" Margin="0,0,0,25" Checked="ChkOptimizePvp_Changed" Unchecked="ChkOptimizePvp_Changed"/>

                                    <!-- Actions & Directory Shortcuts -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="📂 Carpeta de Mods (.raidclient/mods)" Style="{StaticResource ActionButtonStyle}" Background="#1E273A" Foreground="#00E5FF" Margin="0,0,10,10" Click="BtnOpenMods_Click"/>
                                        <Button Content="📁 Carpeta de Datos (.raidclient)" Style="{StaticResource ActionButtonStyle}" Background="#1E273A" Foreground="#00E5FF" Margin="0,0,10,10" Click="BtnOpenLauncherDir_Click"/>
                                        <Button Content="📜 Ver Registro de Logs" Style="{StaticResource ActionButtonStyle}" Background="#1E273A" Foreground="#00E5FF" Margin="0,0,10,10" Click="BtnViewLogs_Click"/>
                                        <Button Content="⚡ Instalar en PATH y Accesos" Style="{StaticResource ActionButtonStyle}" Background="#1E273A" Foreground="#00E5FF" Margin="0,0,10,10" Click="BtnReinstallPath_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 4: HARDWARE & OPTIMIZACIÓN -->
                    <Grid x:Name="TabHardware" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Action Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Diagnóstico y Optimización de Hardware" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Detección de controladores, tarjeta gráfica y configuración automática para 1.8.9" FontSize="12" Foreground="#8E95A5" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="🔄 Re-escanear" Padding="12,8" Background="#161B29" Foreground="#8E95A5" BorderBrush="#252D40" BorderThickness="1" Cursor="Hand" Margin="0,0,10,0" Click="BtnRescanHardware_Click"/>
                                <Button Content="⚡ OPTIMIZAR PARA MI PC" Padding="16,8" Background="#00E5FF" Foreground="#0E121B" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnAutoOptimizeHardware_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hardware Overview Score Bar -->
                        <Border Grid.Row="1" Background="#141826" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#232A3E" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Salud de Optimización:" FontSize="13" FontWeight="SemiBold" Foreground="#FFF" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <ProgressBar Grid.Column="1" x:Name="ProgressHardwareScore" Style="{StaticResource RaidProgressBarStyle}" Height="10" Minimum="0" Maximum="100" Value="85" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="TxtHardwareScore" Text="85% Optimizado" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- 4 Hardware Cards Grid -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: GPU & Drivers -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#141826" CornerRadius="10" Padding="15" Margin="0,0,8,8" BorderBrush="#232A3E" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🎮  TARJETA GRÁFICA &amp; DRIVERS" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                        <Border x:Name="BadgeGpuDriver" Background="#1D3325" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock x:Name="TxtGpuDriverBadge" Text="CONTROLADOR AL DÍA" FontSize="9" FontWeight="Bold" Foreground="#4ADE80"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtGpuName" Text="Intel(R) Iris(R) Xe Graphics" FontSize="14" FontWeight="Bold" Foreground="#FFF"/>
                                    <TextBlock x:Name="TxtGpuDriverVersion" Text="Driver: 32.0.101.7088 (16/06/2026)" FontSize="11" Foreground="#8E95A5" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtGpuPerfStatus" Text="✓ VBOs activos para descarga de CPU a GPU" FontSize="11" Foreground="#4ADE80" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: CPU & Cores -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#141826" CornerRadius="10" Padding="15" Margin="8,0,0,8" BorderBrush="#232A3E" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="⚙️  PROCESADOR (CPU)" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtCpuName" Text="11th Gen Intel Core i5-1140G7" FontSize="14" FontWeight="Bold" Foreground="#FFF"/>
                                    <TextBlock x:Name="TxtCpuCores" Text="4 Núcleos / 8 Hilos de procesamiento" FontSize="11" Foreground="#8E95A5" Margin="0,2,0,0"/>
                                    <TextBlock Text="✓ Rendimiento Monohilo óptimo para 1.8.9" FontSize="11" Foreground="#4ADE80" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: RAM & Garbage Collector -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#141826" CornerRadius="10" Padding="15" Margin="0,8,8,0" BorderBrush="#232A3E" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🧠  MEMORIA RAM &amp; JVM" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtRamSummary" Text="16 GB RAM Instalada" FontSize="14" FontWeight="Bold" Foreground="#FFF"/>
                                    <TextBlock x:Name="TxtRamRecommendation" Text="Asignada al juego: 3 GB (Punto óptimo para 1.8.9)" FontSize="11" Foreground="#8E95A5" Margin="0,2,0,0"/>
                                    <TextBlock Text="✓ Recolector G1GC activado (Cero freeze spikes)" FontSize="11" Foreground="#4ADE80" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Monitor & FPS Refresh -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#141826" CornerRadius="10" Padding="15" Margin="8,8,0,0" BorderBrush="#232A3E" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🖥️  MONITOR &amp; TASA DE REFRESCO" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtMonitorSummary" Text="Pantalla a 60 Hz detectada" FontSize="14" FontWeight="Bold" Foreground="#FFF"/>
                                    <TextBlock Text="VSync: Desactivado en el cliente para máxima fluidez" FontSize="11" Foreground="#8E95A5" Margin="0,2,0,0"/>
                                    <TextBlock Text="✓ Límite de FPS desbloqueado a 260 / Ilimitado" FontSize="11" Foreground="#4ADE80" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>

            <!-- Bottom Status Bar with Glowing Progress Accent -->
            <Border Grid.Row="2" Background="#0B0D13" CornerRadius="0,0,12,12">
                <Grid>
                    <!-- Global slim progress bar on the top edge of status bar -->
                    <ProgressBar x:Name="ProgressBarGlobal" Style="{StaticResource RaidProgressBarStyle}" Height="2" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Top" Visibility="Collapsed"/>

                    <Grid Margin="15,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatus" Text="Listo para jugar con Raid Client." FontSize="11" Foreground="#7E879B"/>
                        <Button Content="📜 Ver Logs" Background="Transparent" Foreground="#00E5FF" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,195,0" Click="BtnViewLogs_Click"/>
                        <TextBlock Text="Raid Launcher v1.0 • Hecho para 1.8.9" FontSize="11" Foreground="#4E566D" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
