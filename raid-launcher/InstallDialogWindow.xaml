<Window x:Class="RaidLauncher.InstallDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalación de Raid Client"
        Height="470" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00E5FF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33ECFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#00B4D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A2130"/>
            <Setter Property="Foreground" Value="#9EA8BD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="secBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="secBorder" Property="Background" Value="#252E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE3F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#0E1118" CornerRadius="12" BorderBrush="#232A3B" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#141824" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/icon.png" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="INSTALADOR DE RAID CLIENT" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="25,20,25,10">
                <TextBlock Text="Instalar Raid Client en su propio espacio" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                <TextBlock Text="Para evitar problemas al ejecutarse desde la carpeta de Descargas (Downloads) o carpetas temporales, se recomienda instalar el lanzador en su ubicación permanente e integrarlo con Windows." 
                           FontSize="12" Foreground="#8B95A8" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,15"/>

                <!-- Install Directory Info Card -->
                <Border Background="#141826" CornerRadius="8" Padding="12,10" Margin="0,0,0,15" BorderBrush="#232A3E" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="UBICACIÓN DE INSTALACIÓN:" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtInstallPath" Text="C:\Users\...\AppData\Local\Programs\RaidClient" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <TextBlock Text="OPCIONES DE INSTALACIÓN:" FontSize="11" FontWeight="Bold" Foreground="#6E7890" Margin="0,0,0,8"/>

                <CheckBox x:Name="ChkAddToPath" IsChecked="True">
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock Text="Agregar al PATH de Windows" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Permite abrir Raid Client escribiendo 'raid' o 'raidclient' en cualquier consola o Win+R." FontSize="10" Foreground="#7E879B"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox x:Name="ChkDesktopShortcut" IsChecked="False">
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock Text="Crear acceso directo en el Escritorio" FontWeight="SemiBold"/>
                        <TextBlock Text="Opcional. Si tienes OneDrive, Windows Defender puede mostrar aviso de seguridad." FontSize="10" Foreground="#7E879B"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox x:Name="ChkStartMenuShortcut" IsChecked="True">
                    <TextBlock Text="Crear acceso directo en el Menú Inicio" FontWeight="SemiBold" Margin="5,0,0,0"/>
                </CheckBox>
            </StackPanel>

            <!-- Bottom Action Buttons -->
            <Border Grid.Row="2" Background="#121520" CornerRadius="0,0,12,12" Padding="25,12">
                <Grid>
                    <Button Content="Solo ejecutar por ahora" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="BtnSkip_Click"/>
                    <Button Content="⚡ INSTALAR Y ABRIR" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Click="BtnInstall_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
